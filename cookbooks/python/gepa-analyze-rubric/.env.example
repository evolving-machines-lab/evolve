# OpenAI-compatible gateway both models go through (never commit the key)
LLM_GATEWAY_API_KEY=
GW_BASE=https://api.llmgateway.io/v1

# Judge: runs the analyzer prompt on each example. Reflection: GEPA's rewriter.
JUDGE_MODEL=openai/deepseek/deepseek-v4.1-flash
REFLECT_MODEL=openai/zai/glm-5.3-flash

# USD per 1M tokens: input,output,cached input (DeepSeek doubles at peak; applied automatically)
JUDGE_PRICE=0.15,0.60,0.003
REFLECT_PRICE=0.15,0.50,0.03

# TRACE is gated: accept its terms on huggingface.co, then set a read token
HF_TOKEN=
