{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Evolve",
  "theme": "maple",
  "colors": {
    "primary": "#B026FF",
    "light": "#C45CFF",
    "dark": "#B026FF"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/wordmark-light.png",
    "dark": "/logo/wordmark-dark.png",
    "href": "https://evolvingmachines.ai"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "light": "#f7f6f5",
      "dark": "#0a0a0a"
    }
  },
  "fonts": {
    "family": "NB International Pro",
    "weight": 400,
    "source": "/fonts/nb-international-pro-regular.woff2",
    "format": "woff2",
    "heading": {
      "family": "NB International Pro",
      "weight": 400,
      "source": "/fonts/nb-international-pro-regular.woff2",
      "format": "woff2"
    },
    "body": {
      "family": "STK Bureau Serif",
      "weight": 400,
      "source": "/fonts/stk-bureau-serif-book.woff2",
      "format": "woff2"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/evolving-machines-lab/evolve"
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://evolvingmachines.ai",
      "github": "https://github.com/evolving-machines-lab/evolve",
      "discord": "https://discord.gg/Q36D8dGyNF"
    }
  },
  "contextual": {
    "options": ["copy", "view", "claude", "chatgpt"],
    "display": "header"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "getting-started/installation",
              "getting-started/quick-start"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "core-concepts/tasks-and-datasets",
              "core-concepts/jobs",
              "core-concepts/trials",
              "core-concepts/agents",
              "core-concepts/models",
              "core-concepts/sandboxes",
              "core-concepts/analyze",
              "core-concepts/check",
              "core-concepts/sessions",
              "core-concepts/skills",
              "core-concepts/secrets",
              "core-concepts/upload"
            ]
          },
          {
            "group": "SDK",
            "pages": [
              "sdk/typescript",
              "sdk/python"
            ]
          }
        ]
      },
      {
        "tab": "CLI reference",
        "groups": [
          {
            "group": "The evolve command",
            "pages": [
              "cli-reference/index",
              "cli-reference/run",
              "cli-reference/analyze",
              "cli-reference/check",
              "cli-reference/upload"
            ]
          },
          {
            "group": "Command groups",
            "pages": [
              "cli-reference/job",
              "cli-reference/trial",
              "cli-reference/analysis",
              "cli-reference/session",
              "cli-reference/dataset",
              "cli-reference/skill",
              "cli-reference/agent",
              "cli-reference/auth",
              "cli-reference/secrets"
            ]
          }
        ]
      }
    ]
  }
}
