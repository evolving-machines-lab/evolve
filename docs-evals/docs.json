{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Evolve",
  "description": "Run managed evaluations with the Evolve CLI and Python or TypeScript SDK. Start and inspect jobs, publish Harbor-format datasets, configure agents and models, read trials and files, analyze traces, check task quality, and manage teams, sharing, skills, and secrets. For running agents directly with the SDK builder, Swarm, or Pipeline, use the separate evolve-agents skill.",
  "theme": "maple",
  "colors": {
    "primary": "#9D20E8",
    "light": "#C36BFF",
    "dark": "#B026FF"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/wordmark-light.png",
    "dark": "/logo/wordmark-dark.png",
    "href": "https://evolvingmachines.ai"
  },
  "appearance": {
    "default": "light"
  },
  "background": {
    "color": {
      "light": "#f7f6f5",
      "dark": "#0a0a0a"
    }
  },
  "fonts": {
    "family": "Google Sans Flex",
    "weight": 400,
    "heading": {
      "family": "Google Sans Flex",
      "weight": 600
    }
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/evolving-machines-lab/evolve"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.evolvingmachines.ai"
    }
  },
  "footer": {
    "socials": {
      "website": "https://evolvingmachines.ai",
      "github": "https://github.com/evolving-machines-lab/evolve",
      "discord": "https://discord.gg/Q36D8dGyNF"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt"
    ],
    "display": "header"
  },
  "redirects": [
    {
      "source": "/core-concepts/tasks-and-datasets",
      "destination": "/core-concepts/datasets"
    }
  ],
  "navigation": {
    "tabs": [
